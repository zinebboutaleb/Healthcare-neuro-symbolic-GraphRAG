# --- Graph backend: auto (try Neo4j, fall back to in-memory NetworkX) | neo4j | networkx
GRAPH_BACKEND=auto
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=healthcare123

# --- Embeddings: auto (MiniLM, else lexical fallback) | minilm | hashing
EMBEDDING_BACKEND=auto

# --- LLM: auto | anthropic | openai | ollama | offline
# auto = anthropic if ANTHROPIC_API_KEY set, else openai if OPENAI_API_KEY set, else offline (no generation)
LLM_PROVIDER=hf
HF_MAX_NEW_TOKENS=250
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct    # override the provider default
# OLLAMA_URL=http://localhost:11434
